CONFLUENCE_BASE_URL=https://confluence.example.com/confluence
CONFLUENCE_PAT=
# Kurumsal CA gerekiyorsa PEM dosyası; boşsa sistem sertifikaları kullanılır.
CONFLUENCE_CA_BUNDLE=

# OCR motoru PATH üzerinde değilse tam yolunu yazın.
TESSERACT_CMD=
# İsteğe bağlı yerel görsel model: sadece --vision ile çağrılır.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Yerel arama modelleri (ilk yüklemede model dosyaları indirilir)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Üretimde model revizyonlarını commit SHA ile sabitleyin.
EMBEDDING_REVISION=
RERANK_REVISION=
RAG_DEVICE=cpu
RAG_OFFLINE=0
# RAG_INDEX_PATH=/tam/yol/search.sqlite3
